@model TaskListModel
@*
    A list of tasks (LIST-15: a list of rows that are ticked off one by one). A row: the round check in the colour of the priority (a form: it works without the script;
    tasks.js sends it in the background and lets the row go), the task as a link to its page (title, the first line of the description, date, repeating, deadline,
    sub-tasks, comments, labels, the person it is given to), the project at the right, and the handle for drag and drop when the list is in manual order.
*@
@if (Model.Rows.Count == 0)
{
    if (Model.Empty is not null)
    {
        <p class="md-empty-line">@Model.Empty</p>
    }
}
else
{
    <ul class="mat-itemlist mat-itemlist--lines-inset md-tasks" id="@Model.Id" data-itemlist @(Model.Reorder ? "data-reorder" : "") aria-label="@L["Tasks.Noun"]">
        @foreach (var t in Model.Rows)
        {
            var desc = t.Description?.Split('\n', 2)[0].Trim();
            <li class="mat-item mat-item--top md-task @(t.IsCompleted ? "is-done" : "mat-item--sliding")" data-item-key="@t.Id" data-task="@t.Id" data-priority="@t.Priority">
                <div class="mat-item__row">
                @if (!t.IsCompleted)
                {
                    @* swipe to the right: done; swipe to the left: tomorrow, delete (the toolkit slides the row, tasks.js does the action) *@
                    <div class="mat-item__options mat-item__options--start">
                        <button type="button" class="mat-item__option mat-item__option--accent" data-item-action="complete">@Ui.Icon("check")<span>@L["Tasks.Complete"]</span></button>
                    </div>
                }
                <form class="md-task__check" method="post" action="@(t.IsCompleted ? "/Tasks/Add?handler=Reopen" : "/Tasks/Add?handler=Complete")" data-task-toggle>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@t.Id" />
                    <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                    <button type="submit" class="md-check @Ui.PriorityClass(t.Priority) @(t.IsCompleted ? "is-checked" : "")"
                            aria-label="@L[t.IsCompleted ? "Tasks.Reopen" : "Tasks.Complete"]: @t.Content" title="@L[t.IsCompleted ? "Tasks.Reopen" : "Tasks.Complete"]">
                        @Ui.Icon("check")
                    </button>
                </form>
                <a class="mat-item__main md-task__main" href="/Tasks/Edit?id=@t.Id">
                    <span class="mat-item__body">
                        <span class="md-task__title">@t.Content</span>
                        @if (!string.IsNullOrEmpty(desc))
                        {
                            <span class="md-task__desc">@desc</span>
                        }
                        <span class="md-task__meta">
                            @if (t.DueDate is { } due && (Model.ShowDate || t.DueTime is not null || t.Recurrence is not null))
                            {
                                var (text, cls) = Ui.Due(due, t.DueTime, Model.Today);
                                <span class="md-due @cls" data-due-text>@Ui.Icon(t.Recurrence is null ? "calendar" : "repeat")@(Model.ShowDate ? text : t.DueTime is { } tm ? Dates.Time(tm) : "")</span>
                            }
                            @if (t.Deadline is { } dl)
                            {
                                <span class="md-meta @(dl < Model.Today ? "md-due--overdue" : "")">@Ui.Icon("target")@L["Tasks.DeadlineShort", Dates.Relative(dl, Model.Today)]</span>
                            }
                            @if (t.SubTasks > 0)
                            {
                                <span class="md-meta">@Ui.Icon("list-tree")@t.SubTasksDone/@t.SubTasks</span>
                            }
                            @if (t.Comments > 0)
                            {
                                <span class="md-meta">@Ui.Icon("message-square")@t.Comments</span>
                            }
                            @foreach (var l in t.Labels)
                            {
                                <span class="md-label">@Ui.Icon("tag", null, l.Color)@l.Name</span>
                            }
                            @if (t.AssigneeName is not null)
                            {
                                <span class="md-meta">@Ui.Icon("user")@t.AssigneeName</span>
                            }
                            @if (t.IsCompleted && t.CompletedDate is not null)
                            {
                                <span class="md-meta">@Ui.Icon("check")@L["Tasks.Done"]</span>
                            }
                        </span>
                    </span>
                    @if (Model.ShowProject)
                    {
                        <span class="md-task__project">@(t.ProjectIsInbox ? L["Project.Inbox"].Value : t.ProjectName)@Ui.Icon(t.ProjectIsInbox ? "inbox" : "hash", null, t.ProjectIsInbox ? null : t.ProjectColor)</span>
                    }
                </a>
                @if (Model.Reorder)
                {
                    <div class="mat-item__aside md-task__aside">
                        <button type="button" class="mat-item__handle" aria-label="@L["Tasks.Move", t.Content]">@Ui.Icon("grip")</button>
                    </div>
                }
                @if (!t.IsCompleted)
                {
                    <div class="mat-item__options mat-item__options--end">
                        <button type="button" class="mat-item__option" data-item-action="tomorrow">@Ui.Icon("sun")<span>@L["Common.Date.Tomorrow"]</span></button>
                        <button type="button" class="mat-item__option mat-item__option--danger" data-item-action="delete" data-confirm="@L["Tasks.DeleteConfirm", t.Content]" data-confirm-ok="@L["Common.Delete"]">@Ui.Icon("trash")<span>@L["Common.Delete"]</span></button>
                    </div>
                }
                </div>
            </li>
        }
    </ul>
}
