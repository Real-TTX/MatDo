@model (MenuModel Menu, string Area)
@inject CurrentUser Me
@*
    The menus (SHELL-01 .. SHELL-19): one panel per menu of the switcher at the foot (SHELL-15), the one of the page shown.
    - tasks:    the main action first, the views, the favourites, the personal projects and the projects of each team, the teams
    - settings: profile, keywords, webhooks, password
    - admin:    users, system (administrators only)
    A page names what it belongs to: ViewData["ActiveNav"] or ViewData["ActiveProject"] (the id of a project).
*@
@{
    var m = Model.Menu;
    var path = Context.Request.Path.Value ?? "/";
    var nav = ViewData["ActiveNav"] as string ?? string.Empty;
    var project = ViewData["ActiveProject"] as long?;

    bool Under(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    string Cls(bool active) => "mat-nav__item" + (active ? " is-active" : string.Empty);
    string Cur(bool active) => active ? "page" : null!;
    string Badge(int n) => n > 99 ? "99+" : n.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<nav class="mat-nav__scroll" aria-label="@L["Shell.Area.Tasks"]" data-nav-panel="tasks" hidden="@(Model.Area != "tasks")">
    <ul class="mat-nav__list">
        <li>
            <a class="mat-nav__item mat-nav__item--primary" href="/Today?qa=qa-today#qa-today" data-quick-open aria-haspopup="dialog">@Ui.Icon("plus")<span>@L["QuickAdd.Add"]</span></a>
        </li>

        <li>
            @{ var inbox = project == m.InboxId || nav == "inbox"; }
            <a class="@Cls(inbox)" href="/Inbox" aria-current="@Cur(inbox)">@Ui.Icon("inbox")<span>@L["Project.Inbox"]</span>@if (m.Inbox > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(m.Inbox)</span> }</a>
        </li>
        <li>
            @{ var today = nav == "today"; }
            <a class="@Cls(today)" href="/Today" aria-current="@Cur(today)" data-due-count="@m.Today">@Ui.Icon("calendar-today")<span>@L["Today.Title"]</span>@if (m.Today > 0) { <span class="mat-nav__badge @(m.Overdue > 0 ? "" : "mat-nav__badge--plain")">@Badge(m.Today)@if (m.Overdue > 0) { <span class="mat-sr-only"> @L["Menu.OverdueCount", m.Overdue]</span> }</span> }</a>
        </li>
        <li>
            @{ var upcoming = nav == "upcoming"; }
            <a class="@Cls(upcoming)" href="/Upcoming" aria-current="@Cur(upcoming)">@Ui.Icon("calendar-days")<span>@L["Upcoming.Title"]</span>@if (m.Upcoming > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(m.Upcoming)</span> }</a>
        </li>
        <li>
            @{ var filter = nav == "filter"; }
            <a class="@Cls(filter)" href="/Tasks" aria-current="@Cur(filter)">@Ui.Icon("sliders")<span>@L["Filter.Title"]</span></a>
        </li>
        <li>
            @{ var labels = Under("/Labels"); }
            <a class="@Cls(labels)" href="/Labels" aria-current="@Cur(labels)">@Ui.Icon("tag")<span>@L["Labels.Title"]</span></a>
        </li>
        <li>
            @{ var done = nav == "done"; }
            <a class="@Cls(done)" href="/Tasks/Completed" aria-current="@Cur(done)">@Ui.Icon("circle-check")<span>@L["Completed.Title"]</span></a>
        </li>

        @if (m.Favorites.Count > 0)
        {
            <li class="mat-nav__group" role="presentation">@L["Menu.Favorites"]</li>
            @foreach (var p in m.Favorites)
            {
                <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
            }
        }

        <li class="mat-nav__group mat-nav__group--action" role="presentation">
            <span class="mat-nav__group-title">@L["Menu.MyProjects"]</span>
            <a class="mat-nav__group-action @(Under("/Projects") && project is null ? "is-active" : "")" href="/Projects" aria-label="@L["Menu.ManageProjects"]" title="@L["Menu.ManageProjects"]">@Ui.Icon("settings")</a>
        </li>
        @foreach (var p in m.Personal)
        {
            <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
        }
        @if (m.Personal.Count == 0)
        {
            <li><a class="mat-nav__item md-muted" href="/Projects/Edit">@Ui.Icon("folder-plus")<span>@L["Projects.Create"]</span></a></li>
        }

        @foreach (var team in m.Teams)
        {
            <li class="mat-nav__group mat-nav__group--action" role="presentation">
                <span class="mat-nav__group-title">@team.TeamName</span>
                <a class="mat-nav__group-action" href="/Teams/Members?id=@team.TeamId" aria-label="@L["Menu.ManageTeam", team.TeamName]" title="@L["Menu.ManageTeam", team.TeamName]">@Ui.Icon("users")</a>
            </li>
            @foreach (var p in team.Projects)
            {
                <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
            }
            @if (team.Projects.Count == 0)
            {
                <li><a class="mat-nav__item md-muted" href="/Projects/Edit?team=@team.TeamId">@Ui.Icon("folder-plus")<span>@L["Projects.CreateTeam"]</span></a></li>
            }
        }

        <li class="mat-nav__group" role="presentation">@L["Menu.Collaboration"]</li>
        <li><a class="@Cls(Under("/Teams"))" href="/Teams" aria-current="@Cur(Under("/Teams"))">@Ui.Icon("users")<span>@L["Teams.Title"]</span></a></li>
    </ul>
</nav>

<nav class="mat-nav__scroll" aria-label="@L["Settings.Title"]" data-nav-panel="settings" hidden="@(Model.Area != "settings")">
    <ul class="mat-nav__list">
        <li><a class="@Cls(path.Equals("/Account", StringComparison.OrdinalIgnoreCase))" href="/Account" aria-current="@Cur(path.Equals("/Account", StringComparison.OrdinalIgnoreCase))">@Ui.Icon("user")<span>@L["Settings.Profile"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Keywords"))" href="/Account/Keywords" aria-current="@Cur(Under("/Account/Keywords"))">@Ui.Icon("type")<span>@L["Keywords.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Webhooks"))" href="/Account/Webhooks" aria-current="@Cur(Under("/Account/Webhooks"))">@Ui.Icon("webhook")<span>@L["Webhooks.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Notifications"))" href="/Account/Notifications" aria-current="@Cur(Under("/Account/Notifications"))">@Ui.Icon("bell")<span>@L["Notifications.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Hotkeys"))" href="/Account/Hotkeys" aria-current="@Cur(Under("/Account/Hotkeys"))">@Ui.Icon("keyboard")<span>@L["Hotkeys.Title"]</span></a></li>
        <li><a class="@Cls(Under("/Account/Password"))" href="/Account/Password" aria-current="@Cur(Under("/Account/Password"))">@Ui.Icon("lock")<span>@L["Password.Title"]</span></a></li>
    </ul>
</nav>

@if (Me.IsAdmin)
{
    <nav class="mat-nav__scroll" aria-label="@L["Admin.Title"]" data-nav-panel="admin" hidden="@(Model.Area != "admin")">
        <ul class="mat-nav__list">
            <li><a class="@Cls(Under("/Admin/Users"))" href="/Admin/Users" aria-current="@Cur(Under("/Admin/Users"))">@Ui.Icon("user-circle")<span>@L["Users.Title"]</span></a></li>
            <li><a class="@Cls(Under("/Admin/System"))" href="/Admin/System" aria-current="@Cur(Under("/Admin/System"))">@Ui.Icon("server")<span>@L["System.Title"]</span></a></li>
        </ul>
    </nav>
}
