@model MenuModel
@inject CurrentUser Me
@*
    The menu (SHELL-01 .. SHELL-19): the main action first, the views (inbox, today, upcoming, filters, labels, done), the favourites, the personal projects
    and the projects of each team (with an icon to manage them), and for an administrator the administration.
    A page names what it belongs to: ViewData["ActiveNav"] ("today", "upcoming" ...) or ViewData["ActiveProject"] (the id of a project).
*@
@{
    var path = Context.Request.Path.Value ?? "/";
    var nav = ViewData["ActiveNav"] as string ?? string.Empty;
    var project = ViewData["ActiveProject"] as long?;

    bool Under(string prefix) => path.Equals(prefix, StringComparison.OrdinalIgnoreCase) || path.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    string Cls(bool active) => "mat-nav__item" + (active ? " is-active" : string.Empty);
    string Cur(bool active) => active ? "page" : null!;
    string Badge(int n) => n > 99 ? "99+" : n.ToString(System.Globalization.CultureInfo.InvariantCulture);
}
<nav class="mat-nav__scroll" aria-label="Hauptmenü">
    <ul class="mat-nav__list">
        <li>
            <a class="mat-nav__item mat-nav__item--primary" href="/Today?qa=qa-today#qa-today" data-quick-open aria-haspopup="dialog">@Ui.Icon("plus")<span>Aufgabe hinzufügen</span></a>
        </li>

        <li>
            @{ var inbox = project == Model.InboxId || nav == "inbox"; }
            <a class="@Cls(inbox)" href="/Inbox" aria-current="@Cur(inbox)">@Ui.Icon("inbox")<span>Eingang</span>@if (Model.Inbox > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(Model.Inbox)<span class="mat-sr-only"> offen</span></span> }</a>
        </li>
        <li>
            @{ var today = nav == "today"; }
            <a class="@Cls(today)" href="/Today" aria-current="@Cur(today)">@Ui.Icon("calendar-today")<span>Heute</span>@if (Model.Today > 0) { <span class="mat-nav__badge @(Model.Overdue > 0 ? "" : "mat-nav__badge--plain")">@Badge(Model.Today)<span class="mat-sr-only"> fällig@(Model.Overdue > 0 ? $", {Model.Overdue} überfällig" : "")</span></span> }</a>
        </li>
        <li>
            @{ var upcoming = nav == "upcoming"; }
            <a class="@Cls(upcoming)" href="/Upcoming" aria-current="@Cur(upcoming)">@Ui.Icon("calendar-days")<span>Demnächst</span>@if (Model.Upcoming > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(Model.Upcoming)</span> }</a>
        </li>
        <li>
            @{ var filter = nav == "filter"; }
            <a class="@Cls(filter)" href="/Tasks" aria-current="@Cur(filter)">@Ui.Icon("sliders")<span>Filter &amp; Suche</span></a>
        </li>
        <li>
            @{ var labels = Under("/Labels"); }
            <a class="@Cls(labels)" href="/Labels" aria-current="@Cur(labels)">@Ui.Icon("tag")<span>Labels</span></a>
        </li>
        <li>
            @{ var done = nav == "done"; }
            <a class="@Cls(done)" href="/Tasks/Completed" aria-current="@Cur(done)">@Ui.Icon("circle-check")<span>Erledigt</span></a>
        </li>

        @if (Model.Favorites.Count > 0)
        {
            <li class="mat-nav__group" role="presentation">Favoriten</li>
            @foreach (var p in Model.Favorites)
            {
                <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
            }
        }

        <li class="mat-nav__group mat-nav__group--action" role="presentation">
            <span class="mat-nav__group-title">Meine Projekte</span>
            <a class="mat-nav__group-action @(Under("/Projects") && project is null ? "is-active" : "")" href="/Projects" aria-label="Projekte verwalten" title="Projekte verwalten">@Ui.Icon("settings")</a>
        </li>
        @foreach (var p in Model.Personal)
        {
            <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
        }
        @if (Model.Personal.Count == 0)
        {
            <li><a class="mat-nav__item md-muted" href="/Projects/Edit">@Ui.Icon("folder-plus")<span>Projekt anlegen</span></a></li>
        }

        @foreach (var team in Model.Teams)
        {
            <li class="mat-nav__group mat-nav__group--action" role="presentation">
                <span class="mat-nav__group-title">@team.TeamName</span>
                <a class="mat-nav__group-action" href="/Teams/Members?id=@team.TeamId" aria-label="Team @team.TeamName verwalten" title="Team verwalten">@Ui.Icon("users")</a>
            </li>
            @foreach (var p in team.Projects)
            {
                <li><a class="@Cls(project == p.Id)" href="/Projects/View?id=@p.Id" aria-current="@Cur(project == p.Id)">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span>@if (p.Open > 0) { <span class="mat-nav__badge mat-nav__badge--plain">@Badge(p.Open)</span> }</a></li>
            }
            @if (team.Projects.Count == 0)
            {
                <li><a class="mat-nav__item md-muted" href="/Projects/Edit?team=@team.TeamId">@Ui.Icon("folder-plus")<span>Teamprojekt anlegen</span></a></li>
            }
        }

        <li class="mat-nav__group" role="presentation">Zusammenarbeit</li>
        <li><a class="@Cls(Under("/Teams"))" href="/Teams" aria-current="@Cur(Under("/Teams"))">@Ui.Icon("users")<span>Teams</span></a></li>

        @if (Me.IsAdmin)
        {
            <li class="mat-nav__group" role="presentation">Administration</li>
            <li><a class="@Cls(Under("/Admin/Users"))" href="/Admin/Users" aria-current="@Cur(Under("/Admin/Users"))">@Ui.Icon("user-circle")<span>Benutzer</span></a></li>
            <li><a class="@Cls(Under("/Admin/System"))" href="/Admin/System" aria-current="@Cur(Under("/Admin/System"))">@Ui.Icon("server")<span>System</span></a></li>
        }
    </ul>
</nav>
