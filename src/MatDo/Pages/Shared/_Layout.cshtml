@inject Assets Toolkit
@inject CurrentUser Me
@inject MenuService Menus
@inject QuickAddEditor Editors
@{
    // A page fills these in: Title, PageSub (one line under it), Crumbs (the breadcrumb: a list of (Text, Url?)), Width ("narrow" or "wide"),
    // OwnHead (the page draws its own head), ActiveNav (the item of the menu), ActiveProject (the id of a project). The menu (tasks, settings, admin) follows the address.
    var user = Me.Snapshot!;
    var title = ViewData["Title"] as string ?? Ui.AppName;
    var sub = ViewData["PageSub"] as string;
    var crumbs = ViewData["Crumbs"] as IReadOnlyList<(string Text, string? Url)> ?? [];
    var width = ViewData["Width"] as string;
    var ownHead = ViewData["OwnHead"] is true;
    var menu = await Menus.GetAsync();
    var here = Context.Request.Path + Context.Request.QueryString;
    var dialogEditor = await Editors.CreateAsync("md-qa-dialog", here.ToString(), inDialog: true);
    var themeAttr = user.Theme is "light" or "dark" ? $" data-theme=\"{user.Theme}\"" : string.Empty;
    var area = MenuService.AreaOf(Context.Request.Path.Value);
    var areas = MenuService.Areas(Me.IsAdmin);
    var current = areas.First(a => a.Id == area);
}
<!DOCTYPE html>
<html @ClientTexts.RootAttributes() data-app="@Ui.AppId" data-scheme="@user.Scheme"@Html.Raw(themeAttr)>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="@Ui.Accent" />
    <meta name="robots" content="noindex" />
    <title>@title · @Ui.AppName</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/img/favicon-32.png" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" />
    <script src="~/matui/matui.boot.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/matui/matui.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <a class="mat-skip" href="#main">@L["Shell.SkipToContent"]</a>
    @Html.Raw(Toolkit.Sprite)

    <div class="mat-app">
        <aside class="mat-nav" id="mat-nav">
            <div class="mat-nav__brand">
                <a href="/Today" aria-label="@L["Shell.HomeLabel"]">
                    @* the word mark: one image for light and one for dark surfaces, app.css shows the one of the theme *@
                    <img class="md-brandmark md-brandmark--light" src="~/img/logo/matdo-logo.svg" alt="@Ui.AppName" width="152" height="40" />
                    <img class="md-brandmark md-brandmark--dark" src="~/img/logo/matdo-logo-dark.svg" alt="@Ui.AppName" width="152" height="40" />
                </a>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-nav__close" data-nav-close aria-label="@L["Shell.CloseMenu"]">@Ui.Icon("x")</button>
            </div>

            <partial name="_Menu" model="(menu, area)" />

            <div class="mat-nav__foot">
                <div class="mat-nav__switch mat-nav__switch--foot">
                    <button type="button" class="mat-switcher" data-menu-toggle="nav-switch-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-switcher__icon">@Ui.Icon(current.Icon)</span>
                        <span class="mat-switcher__text"><small data-nav-label="@L["Shell.Menu"]">@L["Shell.Menu"]</small><span class="mat-switcher__name">@current.Title</span></span>
                        @Ui.Icon("chevron-up", "mat-switcher__chev")
                        <span class="mat-switcher__dot" hidden></span>
                    </button>
                </div>
                <div class="mat-nav__account">
                    <button type="button" class="mat-user" data-menu-toggle="user-menu" data-menu-place="top" aria-haspopup="menu" aria-expanded="false">
                        <span class="mat-avatar" aria-hidden="true">@Ui.Initials(user.DisplayName)</span>
                        <span class="mat-user__text">
                            <span class="mat-user__name">@user.DisplayName</span>
                            <span class="mat-user__role">@Me.RoleName</span>
                        </span>
                        @Ui.Icon("chevron-up", "mat-user__chev")
                    </button>
                    <button type="button" class="mat-theme" data-theme-toggle data-theme-state="@user.Theme" data-theme-save-url="/Account?handler=Theme" aria-label="@L["Shell.Theme"]" title="@L["Shell.Theme"]">
                        <svg class="mat-icon" data-theme-icon="system" aria-hidden="true" focusable="false"><use href="#mat-i-monitor"></use></svg>
                        <svg class="mat-icon" data-theme-icon="light" aria-hidden="true" focusable="false"><use href="#mat-i-sun"></use></svg>
                        <svg class="mat-icon" data-theme-icon="dark" aria-hidden="true" focusable="false"><use href="#mat-i-moon"></use></svg>
                    </button>
                </div>
                <div class="mat-nav__version">@AppInfo.Version</div>
            </div>
        </aside>

        <div class="mat-main">
            <header class="mat-topbar">
                <button type="button" class="mat-burger" data-nav-toggle aria-label="@L["Shell.OpenMenu"]" aria-controls="mat-nav" aria-expanded="false">@Ui.Icon("menu")</button>
                <nav class="mat-crumbs" aria-label="@L["Shell.Breadcrumb"]">
                    <ol>
                        @if (crumbs.Count == 0)
                        {
                            <li aria-current="page">@title</li>
                        }
                        else
                        {
                            @for (var i = 0; i < crumbs.Count; i++)
                            {
                                var c = crumbs[i];
                                if (i == crumbs.Count - 1 || c.Url is null)
                                {
                                    <li aria-current="page">@c.Text</li>
                                }
                                else
                                {
                                    <li><a href="@c.Url">@c.Text</a></li>
                                }
                            }
                        }
                    </ol>
                </nav>
                <div class="mat-topbar__actions">
                    @await RenderSectionAsync("TopActions", required: false)
                    <button type="button" class="mat-btn mat-btn--primary mat-btn--icon" data-dialog-open="md-quick" aria-haspopup="dialog" aria-label="@L["QuickAdd.AddShortcut"]" data-tip="@L["QuickAdd.AddShortcut"]">@Ui.Icon("plus")</button>
                </div>
            </header>

            <main class="mat-page @(width == "narrow" ? "mat-page--narrow" : width == "wide" ? "mat-page--wide" : "") @(ViewData["PageClass"])" id="main">
                @if (!ownHead)
                {
                    <div class="mat-page__head">
                        <div class="mat-page__title">
                            <h1>@title</h1>
                            @if (!string.IsNullOrEmpty(sub))
                            {
                                <p class="mat-page__sub">@sub</p>
                            }
                        </div>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    @* the switcher of the menus (SHELL-15): tasks, settings and – for an administrator – the administration *@
    <div class="mat-menu" id="nav-switch-menu" role="menu" aria-label="@L["Shell.Menus"]" data-nav-scope="mat-nav" hidden>
        @foreach (var a in areas)
        {
            <button type="button" class="mat-menu__item" role="menuitemradio" aria-checked="@(a.Id == area ? "true" : "false")" data-nav-set="@a.Id" data-nav-title="@a.Title">
                @Ui.Icon(a.Icon)<span>@a.Title</span>
                @Ui.Icon("check", "mat-menu__check")
            </button>
        }
    </div>

    <div class="mat-menu" id="user-menu" role="menu" aria-label="@user.DisplayName" hidden>
        <div class="mat-menu__head">
            <span class="mat-avatar" aria-hidden="true">@Ui.Initials(user.DisplayName)</span>
            <div><strong>@user.DisplayName</strong><small>@user.Email</small></div>
        </div>
        <a class="mat-menu__item" role="menuitem" href="/Account">@Ui.Icon("settings")<span>@L["Settings.Title"]</span></a>
        <div class="mat-menu__sep" role="separator"></div>
        <form method="post" action="/Account/Logout">
            @Html.AntiForgeryToken()
            <button type="submit" class="mat-menu__item mat-menu__item--danger" role="menuitem">@Ui.Icon("logout")<span>@L["Shell.SignOut"]</span></button>
        </form>
    </div>

    <dialog class="mat-dialog md-quick" id="md-quick" aria-labelledby="md-quick-title">
        <div class="mat-dialog__form">
            <div class="mat-dialog__head">
                @Ui.Icon("plus")
                <h2 class="mat-dialog__title" id="md-quick-title">@L["QuickAdd.DialogTitle"]</h2>
                <button type="button" class="mat-btn mat-btn--ghost mat-btn--icon mat-dialog__close" data-dialog-close aria-label="@L["Common.Dialog.Close"]">@Ui.Icon("x")</button>
            </div>
            <div class="mat-dialog__body">
                <partial name="_QuickAdd" model="dialogEditor" />
            </div>
        </div>
    </dialog>

    @* the anti-forgery token of the page: the scripts send it with their requests *@
    <form hidden data-page-token>@Html.AntiForgeryToken()</form>

    @if (TempData["Flash"] is string flash)
    {
        <div data-toast="@flash" data-tone="success" hidden></div>
    }

    @if (TempData["FlashError"] is string flashError)
    {
        <div data-toast="@flashError" data-tone="danger" hidden></div>
    }

    @ClientTexts.Script()
    <script src="~/matui/matui.js" asp-append-version="true"></script>
    <script src="~/js/quickadd.js" asp-append-version="true"></script>
    <script src="~/js/tasks.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
