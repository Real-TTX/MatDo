@model QuickAddModel
@*
    The quick add editor, like Todoist's: one line that is read while it is typed (dates, times, repeating, #project, @label, p1..p4, /section and the keywords of
    the person: the parts that were understood are marked in the text and shown as chips under it, a chip's x stops reading that kind), a description, and the
    buttons for what is easier to pick than to type (date, priority, labels, project). Enter adds the task, Escape closes the editor.
    Without the script it is a plain form: the server reads the text the same way (/Tasks/Add). Several editors can be on one page (the ids come from Model.Id).
*@
@{
    var id = Model.Id;
    var personal = Model.Projects.Where(p => p.TeamId is null).ToList();
    var teams = Model.Projects.Where(p => p.TeamId is not null).GroupBy(p => p.TeamName ?? "Team").ToList();
}
<details class="md-qa @(Model.InDialog ? "md-qa--dialog" : "")" id="@id" data-quickadd open="@(Model.Open || Model.InDialog)">
    <summary class="md-qa__add" hidden="@Model.InDialog">
        <span class="md-qa__plus" aria-hidden="true">@Ui.Icon("plus")</span><span>@Model.AddLabel</span>
    </summary>
    <form class="md-qa__form" method="post" action="/Tasks/Add" novalidate data-qa-form>
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <input type="hidden" name="Editor" value="@id" />
        <input type="hidden" name="DefaultSectionId" value="@Model.DefaultSectionId" />
        <input type="hidden" name="DefaultDueDate" value="@(Model.DefaultDueDate is { } d ? Dates.Iso(d) : "")" data-qa-default-due />
        <input type="hidden" name="ParentId" value="@Model.ParentId" />
        <input type="hidden" name="Off" value="" data-qa-off />
        <input type="hidden" name="DueDate" value="" data-qa-due />
        <input type="hidden" name="DueTime" value="" data-qa-time />
        <input type="hidden" name="NoDate" value="false" data-qa-nodate />
        <input type="hidden" name="Priority" value="" data-qa-priority />
        <input type="hidden" name="Labels" value="@string.Join(",", Model.DefaultLabels)" data-qa-labels />
        <input type="hidden" name="ProjectTouched" value="false" data-qa-touched />

        <div class="md-qa__field">
            <div class="md-qa__mirror" aria-hidden="true" data-qa-mirror></div>
            <textarea class="md-qa__title" id="@id-text" name="Text" rows="1" maxlength="2000" required placeholder="@Model.Placeholder"
                      aria-label="@L["QuickAdd.TaskName"]" aria-describedby="@id-chips" autocomplete="off" spellcheck="true" data-qa-input
                      data-msg-required="@L["Tasks.NameRequired"]"></textarea>
        </div>
        <textarea class="md-qa__desc" id="@id-desc" name="Description" rows="1" maxlength="10000" placeholder="@L["Tasks.Description"]" aria-label="@L["Tasks.Description"]" data-qa-desc></textarea>

        <div class="md-qa__chips" id="@id-chips" aria-live="polite" data-qa-chips></div>

        <div class="md-qa__tools">
            <div class="md-qa__tool">
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm md-btn-collapse" data-pick-open data-qa-open="date" aria-expanded="false" aria-controls="@id-pop-date" aria-label="@L["QuickAdd.ChooseDate"]" data-tip="@L["QuickAdd.ChooseDate"]">@Ui.Icon("calendar")<span data-qa-date-label>@L["QuickAdd.Date"]</span></button>
                <partial name="_DuePop" model="@(new DuePopModel(id + "-pop-date", L["QuickAdd.ChooseDate"].Value, L["QuickAdd.NoDate"].Value))" />
            </div>
            <div class="md-qa__tool">
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm md-btn-collapse" data-pick-open data-qa-open="priority" aria-expanded="false" aria-controls="@id-pop-priority" aria-label="@L["QuickAdd.ChoosePriority"]" data-tip="@L["QuickAdd.ChoosePriority"]">@Ui.Icon("flag")<span data-qa-priority-label>@L["QuickAdd.Priority"]</span></button>
                <partial name="_PriorityPop" model="@(new PriorityPopModel(id + "-pop-priority", L["QuickAdd.ChoosePriority"].Value))" />
            </div>
            <div class="md-qa__tool">
                <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm md-btn-collapse" data-pick-open data-qa-open="labels" aria-expanded="false" aria-controls="@id-pop-labels" aria-label="@L["QuickAdd.ChooseLabels"]" data-tip="@L["QuickAdd.ChooseLabels"]">@Ui.Icon("tag")<span data-qa-labels-label>@L["Labels.Title"]</span></button>
                <div class="md-qa__pop" id="@id-pop-labels" role="dialog" aria-label="@L["QuickAdd.ChooseLabels"]" popover="manual" data-pick-pop="labels">
                    @if (Model.Labels.Count == 0)
                    {
                        <p class="mat-hint">@Html.Raw(L["QuickAdd.NoLabels"].Value)</p>
                    }
                    @foreach (var l in Model.Labels)
                    {
                        <label class="mat-check md-qa__check"><input type="checkbox" value="@l.Name" data-qa-label checked="@Model.DefaultLabels.Contains(l.Name, StringComparer.OrdinalIgnoreCase)" /><span class="mat-check__text">@Ui.Icon("tag", null, l.Color)@l.Name</span></label>
                    }
                </div>
            </div>
            <label class="mat-sr-only" for="@id-project">@L["Tasks.Project"]</label>
            <div class="mat-picker md-qa__project" data-picker="select" data-search hidden="@(Model.ParentId is not null)">
                <input class="mat-picker__input" id="@id-project" name="DefaultProjectId" value="@Model.DefaultProjectId" data-qa-project />
                <div class="mat-picker__options" hidden>
                    @foreach (var p in personal)
                    {
                        <button type="button" class="mat-picker__option" data-value="@p.Id"><span class="mat-picker__text"><span class="mat-picker__name">@(p.IsInbox ? L["Project.Inbox"].Value : p.Name)</span></span></button>
                    }
                    @foreach (var g in teams)
                    {
                        <div class="mat-picker__group" role="group">
                            <div class="mat-picker__group-head">@g.Key</div>
                            @foreach (var p in g)
                            {
                                <button type="button" class="mat-picker__option" data-value="@p.Id"><span class="mat-picker__text"><span class="mat-picker__name">@p.Name</span></span></button>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mat-btn-row mat-btn-row--plain md-qa__foot">
            <button type="submit" class="mat-btn mat-btn--primary mat-btn--sm" data-qa-submit>@Ui.Icon("plus")<span>@Model.AddLabel</span></button>
            <button type="button" class="mat-btn mat-btn--secondary mat-btn--sm" data-qa-cancel>@L["Common.Cancel"]</button>
        </div>
    </form>
</details>
