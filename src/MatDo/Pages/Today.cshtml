@page "/Today"
@model MatDo.Pages.TodayModel
@{
    ViewData["Title"] = L["Today.Title"].Value;
    ViewData["PageSub"] = Dates.Long(Model.Today) + " · " + Model.Toolbar.Counted(Model.Toolbar.Matching);
    ViewData["ActiveNav"] = "today";
    ViewData["Width"] = "narrow";
}

@section TopActions {
    <partial name="_ToolbarTop" model="Model.Toolbar" />
}

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Overdue.Rows.Count > 0)
    {
        <section class="md-group" aria-labelledby="h-overdue">
            <div class="md-group__head">
                <h2 class="md-group__title md-due--overdue" id="h-overdue">@L["Today.Overdue"] <span class="md-group__count">@Model.Overdue.Rows.Count</span></h2>
                <form method="post" asp-page-handler="Reschedule">
                    <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm">@Ui.Icon("calendar-today")<span>@L["Today.Reschedule"]</span></button>
                </form>
            </div>
            <partial name="_TaskList" model="Model.Overdue" />
        </section>
    }

    <section class="md-group" aria-labelledby="h-today">
        <div class="md-group__head">
            <h2 class="md-group__title" id="h-today">@Dates.Short(Model.Today) · @L["Common.Date.Today"] <span class="md-group__count">@Model.Due.Rows.Count</span></h2>
        </div>
        <partial name="_TaskList" model="Model.Due" />
        <partial name="_QuickAdd" model="Model.Editor" />
    </section>

    @if (Model.Overdue.Rows.Count == 0 && Model.Due.Rows.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("circle-check")</span>
            <div class="mat-empty__title">@L["Today.Empty.Title"]</div>
            <p>@Html.Raw(L["Today.Empty.Text"].Value)</p>
        </div>
    }
</div>
