@page "/Tasks/Completed"
@model MatDo.Pages.Tasks.CompletedModel
@{
    ViewData["Title"] = L["Completed.Title"].Value;
    ViewData["PageSub"] = L["Completed.Sub"].Value;
    ViewData["ActiveNav"] = "done";
    ViewData["Width"] = "narrow";
}

@section TopActions {
    <partial name="_ToolbarTop" model="Model.Toolbar" />
}

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.List.Rows.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("circle-check")</span>
            <div class="mat-empty__title">@L[Model.Toolbar.Total == 0 ? "Completed.Empty" : "Tasks.NoMatch"]</div>
            @if (Model.Toolbar.Total > 0)
            {
                <a class="mat-btn mat-btn--secondary" href="@Model.Toolbar.UrlReset()">@Ui.Icon("refresh")<span>@L["Lists.Reset"]</span></a>
            }
        </div>
    }
    else
    {
        <partial name="_TaskList" model="Model.List" />
    }

    <partial name="_Pager" model="Model.Pager" />
</div>
