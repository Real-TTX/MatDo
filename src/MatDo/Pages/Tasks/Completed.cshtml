@page "/Tasks/Completed"
@model MatDo.Pages.Tasks.CompletedModel
@{
    ViewData["Title"] = "Erledigt";
    ViewData["PageSub"] = "Was geschafft ist. Ein Klick auf den Haken öffnet eine Aufgabe wieder.";
    ViewData["ActiveNav"] = "done";
    ViewData["Width"] = "narrow";
}

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.List.Rows.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("circle-check")</span>
            <div class="mat-empty__title">@(Model.Toolbar.Total == 0 ? "Noch nichts erledigt" : "Keine Aufgabe passt")</div>
            @if (Model.Toolbar.Total > 0)
            {
                <a class="mat-btn mat-btn--secondary" href="@Model.Toolbar.UrlReset()">@Ui.Icon("refresh")<span>Zurücksetzen</span></a>
            }
        </div>
    }
    else
    {
        <partial name="_TaskList" model="Model.List" />
    }

    <partial name="_Pager" model="Model.Pager" />
</div>
