@page "/Tasks"
@model MatDo.Pages.Tasks.IndexModel
@{
    ViewData["Title"] = "Filter & Suche";
    ViewData["PageSub"] = "Alle offenen Aufgaben aus deinen Projekten und Teams.";
    ViewData["ActiveNav"] = "filter";
    ViewData["Width"] = "narrow";
}

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.List.Rows.Count == 0)
    {
        <div class="mat-empty">
            <span class="mat-empty__icon">@Ui.Icon("search")</span>
            <div class="mat-empty__title">Keine Aufgabe passt</div>
            <p>Ändere die Suche oder die Filter.</p>
            <a class="mat-btn mat-btn--secondary" href="@Model.Toolbar.UrlReset()">@Ui.Icon("refresh")<span>Zurücksetzen</span></a>
        </div>
    }
    else
    {
        <partial name="_TaskList" model="Model.List" />
    }

    <partial name="_Pager" model="Model.Pager" />
</div>
