@page "/Account/Webhooks"
@model MatDo.Pages.Account.Webhooks.IndexModel
@{
    ViewData["Title"] = L["Webhooks.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Settings.Title"].Value, "/Account"), (L["Webhooks.Title"].Value, null) };
}

<p class="mat-muted md-intro">@L["Webhooks.Intro"]</p>

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Items.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("webhook", L[Model.Toolbar.Total == 0 ? "Webhooks.Empty.Title" : "Webhooks.NoMatch"].Value, L[Model.Toolbar.Total == 0 ? "Webhooks.Empty.Text" : "Lists.ChangeTools"].Value, Model.Toolbar.Total == 0, "/Account/Webhooks/Edit", L["Webhooks.New"].Value, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <md-table caption="@L["Webhooks.Title"]">
            <thead>
                <tr><th scope="col">@L["Common.Name"]</th><th scope="col">@L["Webhooks.Col.Target"]</th><th scope="col">@L["Common.Status"]</th><th scope="col" class="mat-hide-md">@L["Webhooks.Col.LastUsed"]</th><th scope="col" class="mat-num mat-hide-sm">@L["Webhooks.Col.Uses"]</th><th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th></tr>
            </thead>
            <tbody>
                @foreach (var w in Model.Items)
                {
                    <tr>
                        <td data-label="@L["Common.Name"]"><a class="md-name" href="/Account/Webhooks/Edit?id=@w.Id">@Ui.Icon("webhook")<span>@w.Name</span></a></td>
                        <td data-label="@L["Webhooks.Col.Target"]">@(w.Target ?? L["Project.Inbox"].Value)</td>
                        <td data-label="@L["Common.Status"]">@if (w.IsActive) { <span class="mat-pill mat-pill--ok">@L["Common.Active"]</span> } else { <span class="mat-pill mat-pill--plain">@L["Webhooks.Off"]</span> }</td>
                        <td data-label="@L["Webhooks.Col.LastUsed"]" class="mat-hide-md mat-mono">@(w.LastUsed is null ? L["Common.Never"].Value : Dates.Stamp(w.LastUsed, Model.Zone))</td>
                        <td data-label="@L["Webhooks.Col.Uses"]" class="mat-num mat-mono mat-hide-sm">@w.Uses</td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions"><a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Account/Webhooks/Edit?id=@w.Id" aria-label="@L["Common.EditNamed", w.Name]" data-tip="@L["Common.Edit"]">@Ui.Icon("edit")</a></div></td>
                    </tr>
                }
            </tbody>
        </md-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Account/Webhooks/Edit">@Ui.Icon("plus")<span>@L["Webhooks.New"]</span></a>
    </div>
</div>
