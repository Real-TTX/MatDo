@page "/Account/Webhooks/Edit"
@model MatDo.Pages.Account.Webhooks.EditModel
@{
    ViewData["Title"] = Model.IsNew ? L["Webhooks.New"].Value : Model.Name;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Settings.Title"].Value, "/Account"), (L["Webhooks.Title"].Value, "/Account/Webhooks"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-5">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__body mat-form">
                    <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" hint="@L["Webhooks.Name.Hint"]" msg-required="@L["Common.NameRequired"]" />
                    <md-field name="ProjectId" kind="picker" label="@L["Webhooks.Target"]" value="@Model.ProjectId" options="Model.Projects" picker="search" hint="@L["Webhooks.Target.Hint"]" />
                    <md-field name="IsActive" kind="switch" label="@L["Common.Active"]" value="@Model.IsActive.ToString()" />
                </div>
            </div>
            <md-buttons save="@L[Model.IsNew ? "Webhooks.Create" : "Common.Save"]" back="/Account/Webhooks" delete-handler="@(Model.IsNew ? null : "Delete")"
                        delete-label="@L["Webhooks.Delete"]" delete-confirm="@L["Webhooks.DeleteConfirm"]" />
        </form>
    </div>

    @if (Model.Hook is not null)
    {
        <div class="mat-col-12 mat-col-lg-7">
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("link")@L["Webhooks.Address"]</h2></div>
                <div class="mat-card__body mat-form">
                    <div class="mat-field">
                        <label class="mat-label" for="hook-url">@L["Webhooks.PostTo"]</label>
                        <div class="mat-input-group">
                            <input class="mat-input mat-mono" id="hook-url" value="@Model.HookUrl" readonly />
                            <button type="button" class="mat-btn mat-btn--secondary" data-copy="#hook-url">@Ui.Icon("copy")<span>@L["Common.Copy"]</span></button>
                        </div>
                        <span class="mat-hint">@L["Webhooks.Secret"]</span>
                    </div>
                    <form method="post" asp-page-handler="Renew" asp-route-id="@Model.Id">
                        <button type="submit" class="mat-btn mat-btn--ghost mat-btn--sm" data-confirm="@L["Webhooks.RenewConfirm"]" data-confirm-ok="@L["Webhooks.RenewOk"]">@Ui.Icon("refresh")<span>@L["Webhooks.Renew"]</span></button>
                    </form>
                </div>
            </div>

            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("smartphone")@L["Webhooks.Shortcut.Title"]</h2></div>
                <div class="mat-card__body">
                    <ol class="md-steps">
                        <li>@Html.Raw(L["Webhooks.Shortcut.Step1"].Value)</li>
                        <li>@Html.Raw(L["Webhooks.Shortcut.Step2"].Value)</li>
                        <li>@Html.Raw(L["Webhooks.Shortcut.Step3"].Value)</li>
                        <li>@Html.Raw(L["Webhooks.Shortcut.Step4"].Value)</li>
                        <li>@Html.Raw(L["Webhooks.Shortcut.Step5"].Value)</li>
                    </ol>
                </div>
            </div>

            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("terminal")curl</h2></div>
                <div class="mat-card__body">
                    <pre class="md-code" id="hook-curl">curl -X POST "@Model.HookUrl" \
  -H "Content-Type: application/json" \
  -d '{"text": "@L["Webhooks.Curl.Text"]", "description": "@L["Webhooks.Curl.Description"]"}'</pre>
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="button" class="mat-btn mat-btn--ghost mat-btn--sm" data-copy="#hook-curl">@Ui.Icon("copy")<span>@L["Common.Copy"]</span></button>
                    </div>
                    <p class="mat-hint">@Html.Raw(L["Webhooks.Curl.Hint", Model.BaseUrl].Value)</p>
                </div>
            </div>
        </div>
    }
</div>
