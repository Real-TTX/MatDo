@page "/Account/Register"
@model MatDo.Pages.Account.RegisterModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = "Registrieren";
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>@(Model.First ? "MatDo einrichten" : "Konto erstellen")</h1>
        <p class="mat-muted">@(Model.First ? "Das erste Konto ist der Administrator dieser Installation." : "Ein Konto für deine Aufgaben, Projekte und Teams.")</p>
    </div>

    @if (!Model.Open)
    {
        <div class="mat-alert mat-alert--info" role="status">
            @Ui.Icon("info")
            <div class="mat-alert__body">Die Registrierung ist geschlossen. Ein Administrator kann dir ein Konto anlegen.</div>
        </div>
        <div class="mat-btn-row mat-btn-row--plain">
            <a class="mat-btn mat-btn--primary" href="/Account/Login">@Ui.Icon("login")<span>Zur Anmeldung</span></a>
        </div>
    }
    else
    {
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <md-field name="DisplayName" label="Name" required autocomplete="name" value="@Model.DisplayName" maxlength="120" autofocus msg-required="Bitte einen Namen eingeben." />
            <md-field name="Email" kind="email" label="E-Mail-Adresse" required autocomplete="email" inputmode="email" value="@Model.Email" msg-required="Bitte die E-Mail-Adresse eingeben." />
            <md-field name="Password" kind="password" label="Passwort" required autocomplete="new-password" minlength="@PasswordService.MinLength" hint="Mindestens @PasswordService.MinLength Zeichen." msg-required="Bitte ein Passwort wählen." />
            <input type="hidden" name="TimeZone" value="@Model.TimeZone" data-detect-zone />
            <div class="mat-btn-row mat-btn-row--plain">
                <button type="submit" class="mat-btn mat-btn--primary mat-btn--block">@Ui.Icon("rocket")<span>Konto erstellen</span></button>
            </div>
            @if (!Model.First)
            {
                <p class="mat-muted">Schon ein Konto? <a href="/Account/Login">Anmelden</a>.</p>
            }
        </form>
    }
</div>

@section Scripts {
    <script src="~/js/zone.js" asp-append-version="true"></script>
}
