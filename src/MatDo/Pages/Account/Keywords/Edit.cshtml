@page "/Account/Keywords/Edit"
@model MatDo.Pages.Account.Keywords.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neues Schlüsselwort" : "Schlüsselwort bearbeiten";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Einstellungen", "/Account"), ("Schlüsselwörter", "/Account/Keywords"), (Model.IsNew ? "Neu" : Model.Word, null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Word" label="Wort" required value="@Model.Word" maxlength="40" autofocus hint="Groß- und Kleinschreibung ist egal. Mehrere Wörter gehen auch, z. B. „für Projekt“." msg-required="Bitte ein Wort eingeben." />
            <md-field name="Kind" kind="picker" label="Was das Wort einleitet" value="@Model.Kind" options="Model.Kinds" />
        </div>
    </div>
    <md-buttons save="@(Model.IsNew ? "Anlegen" : "Speichern")" back="/Account/Keywords" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="Löschen"
                delete-confirm="@($"Schlüsselwort „{Model.Word}“ löschen?")" />
</form>
