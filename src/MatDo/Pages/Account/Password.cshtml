@page "/Account/Password"
@model MatDo.Pages.Account.PasswordModel
@{
    ViewData["Title"] = L["Password.Title"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Settings.Title"].Value, "/Account"), (L["Password.Title"].Value, null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("lock")@L["Password.Change"]</h2></div>
        <div class="mat-card__body mat-form">
            <md-field name="Current" kind="password" label="@L["Password.Current"]" required autocomplete="current-password" msg-required="@L["Password.Current.Required"]" />
            <md-field name="New" kind="password" label="@L["Password.New"]" required autocomplete="new-password" minlength="@PasswordService.MinLength" hint="@L["Account.Password.Hint", PasswordService.MinLength]" msg-required="@L["Password.New.Required"]" />
            <md-field name="Repeat" kind="password" label="@L["Password.Repeat"]" required autocomplete="new-password" msg-required="@L["Password.Repeat.Required"]" />
        </div>
    </div>
    <md-buttons save="@L["Password.Change"]" save-icon="lock" back="/Account" />
</form>
