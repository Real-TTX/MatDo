@page "/Account/Password"
@model MatDo.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Einstellungen";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Einstellungen", "/Account"), ("Passwort", null) };
    ViewData["Width"] = "narrow";
}

<partial name="_AccountTabs" model="@("password")" />

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("lock")Passwort ändern</h2></div>
        <div class="mat-card__body mat-form">
            <md-field name="Current" kind="password" label="Aktuelles Passwort" required autocomplete="current-password" msg-required="Bitte das aktuelle Passwort eingeben." />
            <md-field name="New" kind="password" label="Neues Passwort" required autocomplete="new-password" minlength="@PasswordService.MinLength" hint="Mindestens @PasswordService.MinLength Zeichen." msg-required="Bitte ein neues Passwort eingeben." />
            <md-field name="Repeat" kind="password" label="Neues Passwort wiederholen" required autocomplete="new-password" msg-required="Bitte das neue Passwort wiederholen." />
        </div>
    </div>
    <md-buttons save="Passwort ändern" save-icon="lock" back="/Account" />
</form>
