@page "/Projects/View"
@model MatDo.Pages.Projects.ViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["OwnHead"] = true;
    ViewData["Width"] = "narrow";
    ViewData["Crumbs"] = Model.Project.IsInbox
        ? new List<(string, string?)> { (L["Project.Inbox"].Value, null) }
        : new List<(string, string?)> { (Model.Project.Team?.Name ?? L["Menu.MyProjects"].Value, Model.Project.TeamId is null ? "/Projects" : $"/Teams/Members?id={Model.Project.TeamId}"), (Model.Project.Name, null) };
    var doneUrl = $"/Projects/View?id={Model.Project.Id}" + (Model.ShowDone ? "" : "&done=true");
    var sub = Model.Project.Team is { } team ? L["Projects.View.TeamOpen", team.Name, Model.Toolbar.Counted(Model.Toolbar.Total)].Value
        : Model.Project.IsInbox ? L["Projects.View.InboxOpen", Model.Toolbar.Counted(Model.Toolbar.Total)].Value
        : L["Projects.View.Open", Model.Toolbar.Counted(Model.Toolbar.Total)].Value;
}

@section TopActions {
    <partial name="_ToolbarTop" model="Model.Toolbar" />
}

<div class="mat-page__head">
    <div class="mat-page__title">
        <h1 class="md-title">@if (Model.Project.IsInbox) { @Ui.Icon("inbox") } else { @Ui.Icon("hash", null, Model.Project.Color) }@Model.Title</h1>
        <p class="mat-page__sub">@sub</p>
    </div>
    <div class="mat-page__actions">
        @{ var doneLabel = L[Model.ShowDone ? "Projects.View.HideDone" : "Projects.View.ShowDone"].Value; var editLabel = L["Projects.View.Edit"].Value; }
        <a class="mat-btn mat-btn--ghost mat-btn--sm md-btn-collapse" href="@doneUrl" aria-label="@doneLabel" data-tip="@doneLabel">@Ui.Icon(Model.ShowDone ? "eye-off" : "circle-check")<span>@doneLabel</span></a>
        @if (Model.CanManage && !Model.Project.IsInbox)
        {
            <a class="mat-btn mat-btn--secondary mat-btn--sm md-btn-collapse" href="/Projects/Edit?id=@Model.Project.Id" aria-label="@editLabel" data-tip="@editLabel">@Ui.Icon("edit")<span>@editLabel</span></a>
        }
    </div>
</div>

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    <section class="md-group" aria-label="@L["Projects.View.NoSection"]">
        <partial name="_TaskList" model="Model.Loose" />
        @if (Model.LooseEditor is not null)
        {
            <partial name="_QuickAdd" model="Model.LooseEditor" />
        }
        @if (Model.Filtered && Model.Loose.Rows.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("search")</span>
                <div class="mat-empty__title">@L["Tasks.NoMatch"]</div>
                <a class="mat-btn mat-btn--secondary" href="@Model.Toolbar.UrlReset()">@Ui.Icon("refresh")<span>@L["Lists.Reset"]</span></a>
            </div>
        }
    </section>

    @foreach (var (sec, list, editor) in Model.Sections)
    {
        <section class="md-group md-section" aria-labelledby="h-@list.Id">
            <div class="md-group__head">
                <h2 class="md-group__title" id="h-@list.Id">@sec.Name <span class="md-group__count">@list.Rows.Count</span></h2>
                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Sections/Edit?id=@sec.Id" aria-label="@L["Sections.EditNamed", sec.Name]" data-tip="@L["Sections.Edit"]">@Ui.Icon("edit")</a>
            </div>
            <partial name="_TaskList" model="list" />
            <partial name="_QuickAdd" model="editor" />
        </section>
    }

    @if (!Model.Filtered)
    {
        <details class="md-newsection">
            <summary class="md-newsection__add">@Ui.Icon("plus")<span>@L["Sections.Add"]</span></summary>
            <form class="md-newsection__form" method="post" asp-page-handler="AddSection" asp-route-id="@Model.Project.Id" novalidate>
                <md-field name="SectionName" label="@L["Sections.Name"]" required maxlength="120" msg-required="@L["Common.NameRequired"]" />
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary mat-btn--sm">@Ui.Icon("plus")<span>@L["Sections.Add"]</span></button>
                </div>
            </form>
        </details>
    }

    @if (Model.Done is not null)
    {
        <section class="md-group" aria-labelledby="h-done">
            <div class="md-group__head"><h2 class="md-group__title" id="h-done">@L["Completed.Title"] <span class="md-group__count">@Model.Done.Rows.Count</span></h2></div>
            <partial name="_TaskList" model="Model.Done" />
        </section>
    }
</div>
