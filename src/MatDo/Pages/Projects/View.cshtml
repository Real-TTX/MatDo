@page "/Projects/View"
@model MatDo.Pages.Projects.ViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["OwnHead"] = true;
    ViewData["Width"] = "narrow";
    ViewData["Crumbs"] = Model.Project.IsInbox
        ? new List<(string, string?)> { ("Eingang", null) }
        : new List<(string, string?)> { (Model.Project.Team?.Name ?? "Meine Projekte", Model.Project.TeamId is null ? "/Projects" : $"/Teams/Members?id={Model.Project.TeamId}"), (Model.Project.Name, null) };
    var doneUrl = $"/Projects/View?id={Model.Project.Id}" + (Model.ShowDone ? "" : "&done=true");
}

<div class="mat-page__head">
    <div class="mat-page__title">
        <h1 class="md-title">@if (Model.Project.IsInbox) { @Ui.Icon("inbox") } else { @Ui.Icon("hash", null, Model.Project.Color) }@Model.Title</h1>
        <p class="mat-page__sub">
            @(Model.Project.Team is { } team ? $"Team {team.Name} · " : Model.Project.IsInbox ? "Hierhin kommt alles ohne Projekt, auch was der Webhook schickt · " : "")@Model.Toolbar.Counted(Model.Toolbar.Total) offen
        </p>
    </div>
    <div class="mat-page__actions">
        <a class="mat-btn mat-btn--ghost mat-btn--sm" href="@doneUrl">@Ui.Icon(Model.ShowDone ? "eye-off" : "circle-check")<span>@(Model.ShowDone ? "Erledigte ausblenden" : "Erledigte anzeigen")</span></a>
        @if (Model.CanManage && !Model.Project.IsInbox)
        {
            <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Projects/Edit?id=@Model.Project.Id">@Ui.Icon("edit")<span>Projekt bearbeiten</span></a>
        }
    </div>
</div>

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />

    <section class="md-group" aria-label="Aufgaben ohne Abschnitt">
        <partial name="_TaskList" model="Model.Loose" />
        @if (Model.LooseEditor is not null)
        {
            <partial name="_QuickAdd" model="Model.LooseEditor" />
        }
        @if (Model.Filtered && Model.Loose.Rows.Count == 0)
        {
            <div class="mat-empty">
                <span class="mat-empty__icon">@Ui.Icon("search")</span>
                <div class="mat-empty__title">Keine Aufgabe passt</div>
                <a class="mat-btn mat-btn--secondary" href="@Model.Toolbar.UrlReset()">@Ui.Icon("refresh")<span>Zurücksetzen</span></a>
            </div>
        }
    </section>

    @foreach (var (sec, list, editor) in Model.Sections)
    {
        <section class="md-group md-section" aria-labelledby="h-@list.Id">
            <div class="md-group__head">
                <h2 class="md-group__title" id="h-@list.Id">@sec.Name <span class="md-group__count">@list.Rows.Count</span></h2>
                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Sections/Edit?id=@sec.Id" aria-label="Abschnitt @sec.Name bearbeiten" data-tip="Abschnitt bearbeiten">@Ui.Icon("edit")</a>
            </div>
            <partial name="_TaskList" model="list" />
            <partial name="_QuickAdd" model="editor" />
        </section>
    }

    @if (!Model.Filtered)
    {
        <details class="md-newsection">
            <summary class="md-newsection__add">@Ui.Icon("plus")<span>Abschnitt hinzufügen</span></summary>
            <form class="md-newsection__form" method="post" asp-page-handler="AddSection" asp-route-id="@Model.Project.Id" novalidate>
                <label class="mat-sr-only" for="SectionName">Name des Abschnitts</label>
                <input class="mat-input" id="SectionName" name="SectionName" maxlength="120" required placeholder="Name des Abschnitts" data-msg-required="Bitte einen Namen eingeben." />
                <div class="mat-btn-row mat-btn-row--plain">
                    <button type="submit" class="mat-btn mat-btn--primary mat-btn--sm">@Ui.Icon("plus")<span>Abschnitt hinzufügen</span></button>
                </div>
            </form>
        </details>
    }

    @if (Model.Done is not null)
    {
        <section class="md-group" aria-labelledby="h-done">
            <div class="md-group__head"><h2 class="md-group__title" id="h-done">Erledigt <span class="md-group__count">@Model.Done.Rows.Count</span></h2></div>
            <partial name="_TaskList" model="Model.Done" />
        </section>
    }
</div>
