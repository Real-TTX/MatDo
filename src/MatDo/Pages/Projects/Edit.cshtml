@page "/Projects/Edit"
@model MatDo.Pages.Projects.EditModel
@{
    ViewData["Title"] = L[Model.IsNew ? "Projects.New" : "Projects.View.Edit"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Projects.Title"].Value, "/Projects"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    ViewData["Width"] = "narrow";
    var swatches = string.Join(",", ProjectService.Colors.Select(c => $"{c.Value}:{c.Name.Replace(' ', '-')}"));
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" autofocus msg-required="@L["Common.NameRequired"]" />
            <md-field name="Color" kind="colour" label="@L["Common.Color"]" value="@Model.Color" picker="swatches=@swatches" />
            <md-field name="Team" kind="select" label="@L["Projects.BelongsTo"]" value="@Model.Team" options="Model.TeamChoices" hint="@L["Projects.BelongsTo.Hint"]" />
            <md-field name="IsFavorite" kind="switch" label="@L["Projects.FavoriteSwitch"]" value="@Model.IsFavorite.ToString()" />
            @if (!Model.IsNew)
            {
                <md-field name="IsArchived" kind="switch" label="@L["Projects.ArchivedSwitch"]" value="@Model.IsArchived.ToString()" />
            }
        </div>
    </div>

    <md-buttons save="@L[Model.IsNew ? "Projects.Create" : "Common.Save"]" back="@(Model.IsNew ? "/Projects" : $"/Projects/View?id={Model.Id}")"
                delete-handler="@(Model.IsNew ? null : "Delete")"
                delete-label="@L["Projects.Delete"]"
                delete-confirm="@L["Projects.DeleteConfirm", Model.Name, Model.OpenTasks]" />
</form>
