@page "/Admin/System"
@model MatDo.Pages.Admin.SystemModel
@{
    ViewData["Title"] = "System";
    ViewData["PageSub"] = "Einstellungen dieser Installation.";
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", null), ("System", null) };
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-7">
        <form class="mat-form" method="post" novalidate>
            <partial name="_FormSummary" model="ViewData.ModelState" />
            <div class="mat-card">
                <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("settings")Einstellungen</h2></div>
                <div class="mat-card__body mat-form">
                    <md-field name="RegistrationOpen" kind="switch" label="Registrierung offen" value="@Model.RegistrationOpen.ToString()" hint="Aus: nur Administratoren legen neue Konten an." />
                    <md-field name="PublicUrl" kind="url" label="Öffentliche Adresse" value="@Model.PublicUrl" placeholder="https://todo.example.com" optional
                              hint="Für die Webhook-Adressen, die MatDo anzeigt. Leer: die Adresse, unter der die Seite gerade aufgerufen wird." />
                </div>
            </div>
            <md-buttons save="Speichern" back="/Today" />
        </form>
    </div>
    <div class="mat-col-12 mat-col-lg-5">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("info")Über diese Installation</h2></div>
            <div class="mat-card__body">
                <dl class="md-dl">
                    <dt>Version</dt><dd class="mat-mono">@AppInfo.Version</dd>
                    <dt>Datenbank</dt><dd class="mat-mono">@Model.Database</dd>
                    <dt>Benutzer</dt><dd>@Model.Counts.Users</dd>
                    <dt>Teams</dt><dd>@Model.Counts.Teams</dd>
                    <dt>Projekte</dt><dd>@Model.Counts.Projects</dd>
                    <dt>Offene Aufgaben</dt><dd>@Model.Counts.Open</dd>
                    <dt>Erledigte Aufgaben</dt><dd>@Model.Counts.Done</dd>
                    <dt>Webhooks</dt><dd>@Model.Counts.Webhooks</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
