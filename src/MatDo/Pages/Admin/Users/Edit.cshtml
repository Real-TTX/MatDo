@page "/Admin/Users/Edit"
@model MatDo.Pages.Admin.Users.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Neuer Benutzer" : Model.DisplayName;
    ViewData["Crumbs"] = new List<(string, string?)> { ("Administration", null), ("Benutzer", "/Admin/Users"), (Model.IsNew ? "Neu" : Model.DisplayName, null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="DisplayName" label="Name" required value="@Model.DisplayName" maxlength="120" msg-required="Bitte einen Namen eingeben." />
            <md-field name="Email" kind="email" label="E-Mail-Adresse" required value="@Model.Email" autocomplete="off" msg-required="Bitte eine E-Mail-Adresse eingeben." />
            <md-field name="Role" kind="select" label="Rolle" value="@Model.Role" options="Model.Roles" />
            <md-field name="IsActive" kind="switch" label="Kann sich anmelden" value="@Model.IsActive.ToString()" />
            <md-field name="Password" kind="password" label="@(Model.IsNew ? "Passwort" : "Neues Passwort")" required="@Model.IsNew" optional="@(!Model.IsNew)" autocomplete="new-password"
                      hint="@(Model.IsNew ? $"Mindestens {PasswordService.MinLength} Zeichen." : "Leer lassen, um es nicht zu ändern. Ein neues Passwort meldet die Person überall ab.")" />
        </div>
    </div>
    <md-buttons save="@(Model.IsNew ? "Konto anlegen" : "Speichern")" back="/Admin/Users" delete-handler="@(Model.IsNew || Model.IsSelf ? null : "Delete")" delete-label="Konto löschen"
                delete-confirm="@($"Konto von {Model.DisplayName} löschen? Die Person wird abgemeldet und kann sich nicht mehr anmelden.")" />
</form>
