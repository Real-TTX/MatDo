@page "/Labels/View"
@model MatDo.Pages.Labels.ViewModel
@{
    ViewData["Title"] = "@" + Model.Label.Name;
    ViewData["PageSub"] = L["Projects.View.Open", Model.Toolbar.Counted(Model.Toolbar.Total)].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Labels.Title"].Value, "/Labels"), (Model.Label.Name, null) };
    ViewData["Width"] = "narrow";
}

@section TopActions {
    <a class="mat-btn mat-btn--ghost mat-btn--icon" href="/Labels/Edit?id=@Model.Label.Id" aria-label="@L["Labels.Edit"]" data-tip="@L["Labels.Edit"]">@Ui.Icon("edit")</a>
}

<div class="mat-list md-view">
    <partial name="_Toolbar" model="Model.Toolbar" />
    <partial name="_TaskList" model="Model.List" />
</div>
