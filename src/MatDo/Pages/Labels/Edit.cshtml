@page "/Labels/Edit"
@model MatDo.Pages.Labels.EditModel
@{
    ViewData["Title"] = L[Model.IsNew ? "Labels.New" : "Labels.Edit"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Labels.Title"].Value, "/Labels"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    ViewData["Width"] = "narrow";
    var swatches = string.Join(",", ProjectService.Colors.Select(c => $"{c.Value}:{c.Name.Replace(' ', '-')}"));
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="60" autofocus msg-required="@L["Common.NameRequired"]" />
            <md-field name="Color" kind="colour" label="@L["Common.Color"]" value="@Model.Color" picker="swatches=@swatches" />
            <md-field name="IsFavorite" kind="switch" label="@L["Common.Favorite"]" value="@Model.IsFavorite.ToString()" />
        </div>
    </div>
    <md-buttons save="@L[Model.IsNew ? "Labels.Create" : "Common.Save"]" back="/Labels" delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="@L["Labels.Delete"]"
                delete-confirm="@L["Labels.DeleteConfirm"]" />
</form>
