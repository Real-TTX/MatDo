@page "/Error"
@model MatDo.Pages.ErrorModel
@{
    Layout = "_LayoutAuth";
    ViewData["Title"] = Model.Title;
}

<div class="mat-auth__card">
    <div class="mat-auth__brand">
        @Ui.Logo("lg")
        <h1>@Model.Title</h1>
        <p class="mat-muted">@Model.Text</p>
    </div>
    <div class="mat-btn-row mat-btn-row--plain">
        <a class="mat-btn mat-btn--primary" href="/">@Ui.Icon("home")<span>Zur Startseite</span></a>
    </div>
</div>
