@page "/Teams"
@model MatDo.Pages.Teams.IndexModel
@{
    ViewData["Title"] = L["Teams.Title"].Value;
}

<div class="mat-list">
    <partial name="_Toolbar" model="Model.Toolbar" />

    @if (Model.Items.Count == 0)
    {
        <partial name="_Empty" model="@(new EmptyStateModel("users", L[Model.Toolbar.Total == 0 ? "Teams.Empty.Title" : "Teams.NoMatch"].Value, L[Model.Toolbar.Total == 0 ? "Teams.Empty.Text" : "Lists.ChangeTools"].Value, Model.Toolbar.Total == 0, "/Teams/Edit", L["Teams.New"].Value, Model.Toolbar.UrlReset()))" />
    }
    else
    {
        <md-table caption="@L["Teams.Title"]">
            <thead>
                <tr><th scope="col">@L["Teams.Col.Team"]</th><th scope="col">@L["Teams.Col.MyRole"]</th><th scope="col" class="mat-num">@L["Teams.Col.Members"]</th><th scope="col" class="mat-num mat-hide-sm">@L["Projects.Title"]</th><th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model.Items)
                {
                    <tr>
                        <td data-label="@L["Teams.Col.Team"]"><a class="md-name" href="/Teams/Members?id=@t.Id">@Ui.Icon("users", null, t.Color)<span>@t.Name</span></a>@if (!string.IsNullOrEmpty(t.Description)) { <small class="mat-muted md-block-line">@t.Description</small> }</td>
                        <td data-label="@L["Teams.Col.MyRole"]"><span class="mat-pill @(t.Role == TeamRole.Owner ? "mat-pill--accent" : "mat-pill--plain")">@L[t.Role == TeamRole.Owner ? "Teams.Role.Owner" : "Teams.Role.Member"]</span></td>
                        <td data-label="@L["Teams.Col.Members"]" class="mat-num mat-mono">@t.Members</td>
                        <td data-label="@L["Projects.Title"]" class="mat-num mat-mono mat-hide-sm">@t.Projects</td>
                        <td class="mat-table__cell-actions"><div class="mat-table__actions">
                            <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Teams/Members?id=@t.Id" aria-label="@L["Teams.MembersOf", t.Name]" data-tip="@L["Teams.Col.Members"]">@Ui.Icon("users")</a>
                            @if (t.Role == TeamRole.Owner)
                            {
                                <a class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" href="/Teams/Edit?id=@t.Id" aria-label="@L["Common.EditNamed", t.Name]" data-tip="@L["Common.Edit"]">@Ui.Icon("edit")</a>
                            }
                        </div></td>
                    </tr>
                }
            </tbody>
        </md-table>
    }

    <partial name="_Pager" model="Model.Pager" />

    <div class="mat-actions">
        <a class="mat-btn mat-btn--primary" href="/Teams/Edit">@Ui.Icon("plus")<span>@L["Teams.New"]</span></a>
    </div>
</div>
