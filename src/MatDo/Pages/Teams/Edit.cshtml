@page "/Teams/Edit"
@model MatDo.Pages.Teams.EditModel
@{
    ViewData["Title"] = L[Model.IsNew ? "Teams.New" : "Teams.Edit"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Teams.Title"].Value, "/Teams"), (Model.IsNew ? L["Common.New"].Value : Model.Name, null) };
    ViewData["Width"] = "narrow";
    var swatches = string.Join(",", ProjectService.Colors.Select(c => $"{c.Value}:{c.Name.Replace(' ', '-')}"));
}

@if (!Model.IsNew)
{
    <md-tabs label="@L["Teams.Col.Team"]">
        <md-tab href="/Teams/Edit?id=@Model.Id" active>@L["Teams.Settings"]</md-tab>
        <md-tab href="/Teams/Members?id=@Model.Id">@L["Teams.Col.Members"]</md-tab>
    </md-tabs>
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" autofocus msg-required="@L["Common.NameRequired"]" />
            <md-field name="Description" kind="textarea" label="@L["Tasks.Description"]" value="@Model.Description" rows="3" maxlength="1000" optional />
            <md-field name="Color" kind="colour" label="@L["Common.Color"]" value="@Model.Color" picker="swatches=@swatches" />
        </div>
    </div>
    <md-buttons save="@L[Model.IsNew ? "Teams.Create" : "Common.Save"]" back="@(Model.IsNew ? "/Teams" : $"/Teams/Members?id={Model.Id}")"
                delete-handler="@(Model.IsNew ? null : "Delete")" delete-label="@L["Teams.Delete"]"
                delete-confirm="@L["Teams.DeleteConfirm"]" />
</form>
