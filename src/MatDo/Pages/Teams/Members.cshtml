@page "/Teams/Members"
@model MatDo.Pages.Teams.MembersModel
@{
    ViewData["Title"] = Model.Team.Name;
    ViewData["PageSub"] = Model.Team.Description ?? L["Teams.Summary", Model.Members.Count, Model.Projects.Count].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (L["Teams.Title"].Value, "/Teams"), (Model.Team.Name, null) };
}

@if (Model.IsOwner)
{
    <md-tabs label="@L["Teams.Col.Team"]">
        <md-tab href="/Teams/Edit?id=@Model.Id">@L["Teams.Settings"]</md-tab>
        <md-tab href="/Teams/Members?id=@Model.Id" active>@L["Teams.Col.Members"]</md-tab>
    </md-tabs>
}

<div class="mat-cols">
    <div class="mat-col-12 mat-col-lg-8">
        <div class="mat-list">
            <md-table caption="@L["Teams.Col.Members"]">
                <thead>
                    <tr><th scope="col">@L["Teams.Col.Member"]</th><th scope="col">@L["Teams.Col.Role"]</th><th scope="col"><span class="mat-sr-only">@L["Common.Actions"]</span></th></tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Members)
                    {
                        var me = m.UserId == Model.MeId;
                        <tr>
                            <td data-label="@L["Teams.Col.Member"]"><div class="mat-table__name"><span class="mat-avatar mat-avatar--sm" aria-hidden="true">@Ui.Initials(m.DisplayName)</span><span>@m.DisplayName@(me ? " " + L["Teams.You"].Value : "")<small class="mat-mono">@m.Email</small></span></div></td>
                            <td data-label="@L["Teams.Col.Role"]"><span class="mat-pill @(m.Role == TeamRole.Owner ? "mat-pill--accent" : "mat-pill--plain")">@L[m.Role == TeamRole.Owner ? "Teams.Role.Owner" : "Teams.Role.Member"]</span></td>
                            <td class="mat-table__cell-actions">
                                <div class="mat-table__actions">
                                    @if (Model.IsOwner)
                                    {
                                        var next = m.Role == TeamRole.Owner ? TeamRole.Member : TeamRole.Owner;
                                        var label = L[next == TeamRole.Owner ? "Teams.MakeOwner" : "Teams.MakeMember"].Value;
                                        <form method="post" asp-page-handler="Role" asp-route-id="@Model.Id" asp-route-memberId="@m.Id" asp-route-role="@next">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm" aria-label="@label: @m.DisplayName" data-tip="@label">@Ui.Icon(next == TeamRole.Owner ? "shield" : "user")</button>
                                        </form>
                                    }
                                    @if (Model.IsOwner || me)
                                    {
                                        <form method="post" asp-page-handler="Remove" asp-route-id="@Model.Id" asp-route-memberId="@m.Id" class="md-sep">
                                            <button type="submit" class="mat-btn mat-btn--ghost mat-btn--icon mat-btn--sm md-danger" aria-label="@(me ? L["Teams.Leave"].Value : L["Teams.RemoveNamed", m.DisplayName].Value)" data-tip="@L[me ? "Teams.Leave" : "Teams.Remove"]"
                                                    data-confirm="@(me ? L["Teams.LeaveConfirm", Model.Team.Name].Value : L["Teams.RemoveConfirm", m.DisplayName].Value)" data-confirm-ok="@L[me ? "Teams.LeaveOk" : "Teams.Remove"]">@Ui.Icon(me ? "logout" : "x")</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </md-table>

            @if (Model.IsOwner)
            {
                <form class="mat-form md-inline-form" method="post" asp-page-handler="Add" asp-route-id="@Model.Id" novalidate>
                    <partial name="_FormSummary" model="ViewData.ModelState" />
                    <md-field name="Email" kind="email" label="@L["Teams.AddMember"]" value="@Model.Email" placeholder="@L["Teams.AddMember.Placeholder"]" autocomplete="off" required
                              hint="@L["Teams.AddMember.Hint"]" msg-required="@L["Account.Login.Email.Required"]" />
                    <div class="mat-btn-row mat-btn-row--plain">
                        <button type="submit" class="mat-btn mat-btn--primary">@Ui.Icon("plus")<span>@L["Teams.Add"]</span></button>
                    </div>
                </form>
            }
        </div>
    </div>
    <div class="mat-col-12 mat-col-lg-4">
        <div class="mat-card">
            <div class="mat-card__head"><h2 class="mat-card__title">@Ui.Icon("hash")@L["Teams.Projects"]</h2></div>
            <div class="mat-card__body">
                @if (Model.Projects.Count == 0)
                {
                    <p class="mat-muted">@L["Teams.NoProjects"]</p>
                }
                else
                {
                    <ul class="md-plainlist">
                        @foreach (var p in Model.Projects)
                        {
                            <li><a class="md-name" href="/Projects/View?id=@p.Id">@Ui.Icon("hash", null, p.Color)<span>@p.Name</span></a> <span class="mat-muted">@L["Teams.OpenCount", p.Open]</span></li>
                        }
                    </ul>
                }
                <div class="mat-btn-row mat-btn-row--plain">
                    <a class="mat-btn mat-btn--secondary mat-btn--sm" href="/Projects/Edit?team=@Model.Id">@Ui.Icon("plus")<span>@L["Projects.CreateTeam"]</span></a>
                </div>
            </div>
        </div>
    </div>
</div>
