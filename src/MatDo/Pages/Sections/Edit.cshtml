@page "/Sections/Edit"
@model MatDo.Pages.Sections.EditModel
@{
    ViewData["Title"] = L["Sections.Edit"].Value;
    ViewData["Crumbs"] = new List<(string, string?)> { (Model.Project.IsInbox ? L["Project.Inbox"].Value : Model.Project.Name, $"/Projects/View?id={Model.Project.Id}"), (Model.Name, null) };
    ViewData["Width"] = "narrow";
}

<form class="mat-form" method="post" novalidate>
    <partial name="_FormSummary" model="ViewData.ModelState" />
    <div class="mat-card">
        <div class="mat-card__body mat-form">
            <md-field name="Name" label="@L["Common.Name"]" required value="@Model.Name" maxlength="120" autofocus msg-required="@L["Common.NameRequired"]" />
            <md-field name="SortOrder" kind="number" label="@L["Sections.Order"]" value="@Model.SortOrder" min="0" max="10000" hint="@L["Sections.Order.Hint"]" />
        </div>
    </div>
    <md-buttons save="@L["Common.Save"]" back="@($"/Projects/View?id={Model.Project.Id}")" delete-handler="Delete" delete-label="@L["Sections.Delete"]"
                delete-confirm="@L["Sections.DeleteConfirm"]" />
</form>
